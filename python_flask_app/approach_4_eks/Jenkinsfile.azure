pipeline {
    agent any

    environment {
        PROJECT_DIR        = 'python_flask_app/approach_4_eks'
        DOCKER_HUB_REPO    = 'guruhemanth/python-transaction-flask-app'
        IMAGE_TAG          = "v4-azure.${BUILD_NUMBER}"
        
        // Azure AKS Configuration
        AZURE_RG           = 'rg-flask-multicloud'
        AKS_CLUSTER_NAME   = 'flask-2fa-aks'
        AZURE_SP_CREDS_ID  = 'azure-service-principal-id' // Configured in Jenkins Credentials (Username/Password)
        AZURE_TENANT_ID    = 'your-azure-tenant-id'
    }

    options {
        timeout(time: 25, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
    }

    stages {
        // ── Stage 0: System Dependencies Check ─────────────────────────────
        stage('0. Setup Linux Dependencies') {
            steps {
                sh '''
                    echo "🔍 Verifying required CLIs: docker, kubectl, az..."
                    command -v docker >/dev/null 2>&1 || { echo "❌ Docker missing"; exit 1; }
                    command -v kubectl >/dev/null 2>&1 || { echo "❌ Kubectl missing"; exit 1; }
                    command -v az >/dev/null 2>&1 || { echo "❌ Azure CLI (az) missing"; exit 1; }
                    echo "✅ System dependencies verified!"
                '''
            }
        }

        // ── Stage 1: Checkout SCM ──────────────────────────────────────────
        stage('1. Checkout Code') {
            steps {
                checkout scm
            }
        }

        // ── Stage 2: Linting & Unit Testing ────────────────────────────────
        stage('2. Test & Lint (Pytest + Flake8)') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    sh '''
                        python3 -m venv venv || python3 -m venv --system-site-packages venv
                        . venv/bin/activate
                        pip install --upgrade pip
                        pip install -r requirements-dev.txt
                        flake8 server_xorkeesign.py models.py routes/auth.py --statistics
                        DATABASE_URL="sqlite:///:memory:" pytest --verbose
                    '''
                }
            }
        }

        // ── Stage 3: Security Audits (SAST & SCA) ──────────────────────────
        stage('3. Security Audits (Bandit & pip-audit)') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    sh '''
                        . venv/bin/activate
                        bandit -r . -x ./venv,./test_app.py
                        pip-audit
                    '''
                }
            }
        }

        // ── Stage 4: Docker Build & Security Scan (Trivy) ──────────────────
        stage('4. Docker Build & Trivy Scan') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    sh '''
                        echo "🐳 Building Docker image ${DOCKER_HUB_REPO}:${IMAGE_TAG}..."
                        docker build -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} .
                        
                        echo "🛡️ Scanning Container image with Trivy..."
                        docker run --rm \
                            -v /var/run/docker.sock:/var/run/docker.sock \
                            aquasec/trivy:latest image \
                            --severity HIGH,CRITICAL \
                            --exit-code 0 \
                            ${DOCKER_HUB_REPO}:${IMAGE_TAG}
                    '''
                }
            }
        }

        // ── Stage 5: Push to Docker Hub ───────────────────────────────────
        stage('5. Push Image to Docker Hub') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    withCredentials([usernamePassword(credentialsId: 'dockerhub-credentials-id', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
                        sh '''
                            echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                            docker tag ${DOCKER_HUB_REPO}:${IMAGE_TAG} ${DOCKER_HUB_REPO}:latest
                            docker push ${DOCKER_HUB_REPO}:${IMAGE_TAG}
                            docker push ${DOCKER_HUB_REPO}:latest
                        '''
                    }
                }
            }
        }

        // ── Stage 6: Deploy to Microsoft Azure AKS ─────────────────────────
        stage('6. Deploy to Azure AKS') {
            steps {
                dir("${env.PROJECT_DIR}") {
                    withCredentials([usernamePassword(credentialsId: env.AZURE_SP_CREDS_ID, usernameVariable: 'AZ_CLIENT_ID', passwordVariable: 'AZ_CLIENT_SECRET')]) {
                        sh '''
                            echo "☁️ Logging into Azure CLI via Service Principal..."
                            az login --service-principal -u "$AZ_CLIENT_ID" -p "$AZ_CLIENT_SECRET" --tenant "${AZURE_TENANT_ID}"
                            
                            echo "🔑 Fetching AKS Kubeconfig..."
                            az aks get-credentials --resource-group "${AZURE_RG}" --name "${AKS_CLUSTER_NAME}" --context aks-cluster --overwrite-existing
                            
                            echo "📦 Deploying Postgres to AKS..."
                            kubectl --context=aks-cluster apply -f postgres-deployment.yaml
                            
                            echo "🚀 Updating deployment image to ${DOCKER_HUB_REPO}:${IMAGE_TAG}..."
                            sed -i "s|image: guruhemanth/python-transaction-flask-app:.*|image: ${DOCKER_HUB_REPO}:${IMAGE_TAG}|g" deployment.yaml
                            kubectl --context=aks-cluster apply -f deployment.yaml
                            
                            echo "⏳ Waiting for AKS rollout status..."
                            kubectl --context=aks-cluster rollout status deployment/flask-app-deployment --timeout=180s
                            
                            echo "✅ Azure AKS Deployment Verified!"
                            kubectl --context=aks-cluster get pods -o wide
                            kubectl --context=aks-cluster get svc
                        '''
                    }
                }
            }
        }
    }

    post {
        always {
            cleanWs()
            echo "🧹 Workspace cleaned up."
        }
        success {
            echo "🎉 Azure AKS Pipeline Completed Successfully!"
        }
        failure {
            echo "🚨 Azure AKS Pipeline Failed! Check build logs."
        }
    }
}
