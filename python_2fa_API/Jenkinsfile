pipeline {
    agent any

    environment {
        DOCKER_HUB_REPO = 'python-transaction-flask-app'
        IMAGE_TAG = "v2.${BUILD_NUMBER}"
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        // ── Stage 0: Universal OS Package Manager Setup ─────────────────────
        stage('0. Setup Linux System Dependencies') {
            steps {
                sh '''
                    echo "🔍 Checking system dependencies (Python3, Pip, Venv, GCC, LibPQ, Docker CLI)..."
                    
                    # Detect OS Package Manager (apt-get for Debian/Ubuntu, yum/dnf for RHEL/Fedora/CentOS)
                    if command -v apt-get >/dev/null 2>&1; then
                        PKG_MANAGER="apt-get"
                        UPDATE_CMD="apt-get update"
                        INSTALL_CMD="apt-get install -y"
                        DEPS="python3 python3-pip python3-venv gcc libpq-dev docker.io"
                    elif command -v dnf >/dev/null 2>&1; then
                        PKG_MANAGER="dnf"
                        UPDATE_CMD="dnf check-update || true"
                        INSTALL_CMD="dnf install -y"
                        DEPS="python3 python3-pip gcc libpq-devel docker"
                    elif command -v yum >/dev/null 2>&1; then
                        PKG_MANAGER="yum"
                        UPDATE_CMD="yum check-update || true"
                        INSTALL_CMD="yum install -y"
                        DEPS="python3 python3-pip gcc postgresql-devel docker"
                    fi

                    # Verify if any tools are missing
                    MISSING=0
                    command -v python3 >/dev/null 2>&1 || MISSING=1
                    python3 -m venv --help >/dev/null 2>&1 || MISSING=1
                    command -v gcc >/dev/null 2>&1 || MISSING=1
                    command -v docker >/dev/null 2>&1 || MISSING=1

                    if [ "$MISSING" -eq 1 ]; then
                        echo "📦 Installing missing system packages using $PKG_MANAGER..."
                        $UPDATE_CMD
                        $INSTALL_CMD $DEPS
                    else
                        echo "✅ All Linux system dependencies (Python3, Venv, GCC, LibPQ, Docker) are ready!"
                    fi
                '''
            }
        }

        // ── Stage 1: Checkout ──────────────────────────────────────────────
        stage('1. Checkout Source Code') {
            steps {
                checkout scm
            }
        }

        // ── Stage 2: Code Linting & Python Dependency Setup ─────────────────
        stage('2. Code Linting (Flake8)') {
            steps {
                sh '''
                    python3 -m venv venv || python3 -m venv --system-site-packages venv
                    . venv/bin/activate
                    pip install --upgrade pip
                    pip install -r requirements.txt flake8 pytest pytest-cov bandit pip-audit
                    flake8 . --count --select=E9,F63,F7,F82 --show-source --statistics
                    flake8 server_xorkeesign.py models.py routes/auth.py
                '''
            }
        }

        // ── Stage 3: Automated Testing ─────────────────────────────────────
        stage('3. Automated Testing (Pytest)') {
            steps {
                sh '''
                    . venv/bin/activate
                    pytest --verbose
                '''
            }
        }

        // ── Stage 4: Security Audits (Bandit & Pip-Audit) ──────────────────
        stage('4. Security Audits') {
            steps {
                sh '''
                    . venv/bin/activate
                    bandit -r . -x ./venv,./test_app.py
                    pip-audit
                '''
            }
        }

        // ── Stage 5: Build Docker Image ────────────────────────────────────
        stage('5. Build Docker Image') {
            steps {
                sh "docker build -t ${DOCKER_HUB_REPO}:${IMAGE_TAG} ."
            }
        }

        // ── Stage 6: Kubernetes Deployment ──────────────────────────────────
        stage('6. Deploy to Kubernetes Cluster') {
            steps {
                sh "kind load docker-image ${DOCKER_HUB_REPO}:${IMAGE_TAG} --name multi-node"
                sh "kubectl apply -f postgres-deployment.yaml"
                sh "kubectl apply -f deployment.yaml"
                sh "kubectl rollout status deployment/flask-app-deployment"
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo "✅ CI/CD Pipeline Executed Successfully!"
        }
        failure {
            echo "❌ CI/CD Pipeline Failed! Check build logs."
        }
    }
}
